# Copy this file to ".env" and fill in your values.
# Supabase: find these in your dashboard under Project Settings > API.
# Both are safe to expose in the browser (the anon key is protected by RLS).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic (Plant AI diagnosis) — from console.anthropic.com > API Keys.
# NOT prefixed with VITE_, so it never reaches the browser bundle — it's only
# read by the server-side function in api/diagnose.js. This only works when
# deployed to Vercel (or run via `vercel dev`) — the plain `npm run dev`
# server does not execute /api functions.
ANTHROPIC_API_KEY=sk-ant-your-key-here
